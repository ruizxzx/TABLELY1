NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3001
TABLELY_PARTNER_ENCRYPTION_KEY=replace-with-a-long-random-server-only-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# 32-byte base64 key used to encrypt restaurant payment secrets
TABLELY_ENCRYPTION_KEY=
# Separate server-only key for partner bank and PAN information (24+ random characters).
TABLELY_PARTNER_ENCRYPTION_KEY=

# Build 32: official WhatsApp Business Cloud API. Meta credentials remain server-only.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=
META_FEEDBACK_TEMPLATE_NAME=
META_REVIEW_TEMPLATE_NAME=

# Build 32: Google Business Profile OAuth/API. Redirect URI must be
# https://<your-domain>/api/engagement/google/callback and added to Google OAuth.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_STATE_SECRET=

# Tablely SaaS subscription billing (separate from restaurant Razorpay credentials)
TABLELY_RAZORPAY_KEY_ID=
TABLELY_RAZORPAY_KEY_SECRET=
TABLELY_RAZORPAY_WEBHOOK_SECRET=
TABLELY_RAZORPAY_ENVIRONMENT=test

# Optional: send public Contact Us submissions to TABLELY
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_ORDER_EMAIL_FROM=
RESEND_REPLY_TO_EMAIL=

# Legacy AI menu extraction bootstrap only. Admin-managed DB routing takes precedence.
# Migrate this credential to /admin/ai-management and remove these values afterward.
TABLELY_MENU_AI_BASE_URL=https://api.openai.com/v1
TABLELY_MENU_AI_API_KEY=
TABLELY_MENU_AI_MODEL=gpt-6-luna
